---
import { navigation, type PageKey } from "../data/site";

interface Props {
  activePage: PageKey;
}

const { activePage } = Astro.props;
const base = import.meta.env.BASE_URL;

const withBase = (href: string) => {
  if (href === "/") return base;
  return `${base}${href.replace(/^\//, "")}`;
};
---

<header class="site-header" data-site-header>
  <div class="header-inner">
    <a class="brand" href={withBase("/")} spa>
      <span class="brand-mark" aria-hidden="true"></span>
      <span>axnikita / Zonov Nikita</span>
    </a>

    <p
      class="site-role role"
      data-lang-ru="Full-stack WEB · Game systems / tooling"
      data-lang-en="Full-stack WEB · Game systems / tooling"
    >
      Full-stack WEB · Game systems / tooling
    </p>

    <div class="header-actions">
      <nav class="site-nav" aria-label="Основная навигация">
        <ul>
          {navigation.map((item) => (
            <li>
              <a
                href={withBase(item.href)}
                aria-current={activePage === item.key ? "page" : undefined}
                data-page-key={item.key}
                spa
                data-lang-ru={item.ru}
                data-lang-en={item.en}
              >
                {item.ru}
              </a>
            </li>
          ))}
        </ul>
      </nav>

      <div class="language-switcher" aria-label="Язык">
        <button type="button" class="lang-button" data-lang-button="ru" aria-pressed="true">RU</button>
        <button type="button" class="lang-button" data-lang-button="en" aria-pressed="false">EN</button>
      </div>
    </div>
  </div>
</header>
