---
import { footerCopy, type PageKey } from "../data/site";

interface Props {
  page: PageKey;
}

const { page } = Astro.props;
const copy = footerCopy[page];
---

<footer class="site-footer" id="contact" data-site-footer>
  <div class="footer-inner">
    <div class="footer-grid">
      <div>
        <p
          class="footer-eyebrow"
          data-lang-ru={copy.eyebrow.ru}
          data-lang-en={copy.eyebrow.en}
        >
          {copy.eyebrow.ru}
        </p>

        <h2>
          <span
            class="footer-title"
            data-lang-ru={copy.title.ru}
            data-lang-en={copy.title.en}
          >
            {copy.title.ru}
          </span>
          <span
            class="footer-title-accent"
            data-lang-ru={copy.accent.ru}
            data-lang-en={copy.accent.en}
          >
            {copy.accent.ru}
          </span>
        </h2>
      </div>

      <div class="footer-contact">
        <p data-lang-ru={copy.text.ru} data-lang-en={copy.text.en}>
          {copy.text.ru}
        </p>

        <div class="contact-links">
          <a href="https://kwork.ru/user/axnikita" target="_blank" rel="noopener noreferrer">Kwork ↗</a>
          <a href="https://github.com/ax-nikita" target="_blank" rel="noopener noreferrer">GitHub ↗</a>
        </div>
      </div>
    </div>

    <div class="footer-bottom">
      <span>© 2026 Zonov Nikita / axnikita</span>
      <span>PORTFOLIO</span>
    </div>
  </div>
</footer>
